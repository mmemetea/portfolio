---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import Loader from '../components/Loader.astro';
import SiteFrame from '../components/SiteFrame.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string; // root-relative path to an above-the-fold media poster
}
const { title, description = site.description, image = '/og.png', preloadImage } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}${image}`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' },
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#e9e7e2" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={`${base}/fonts/archivo-var.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/jetbrains-mono-var.woff2`} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={`${base}${preloadImage}`} fetchpriority="high" />}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      else document.documentElement.classList.add('no-js-motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <div id="cursor" transition:persist="cursor" aria-hidden="true"><span data-cursor-label></span></div>
    <div class="preview" aria-hidden="true"><img alt="" width="680" height="510" /></div>
    <Loader />
    <SiteFrame />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      import { startRun } from '../motion/compress';
      import { buttonFill } from '../motion/fill';
      start(() => {
        setupMotion();
        startRun();
        buttonFill();
      });
    </script>
  </body>
</html>
